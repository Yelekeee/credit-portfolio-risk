{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Portfolio balance and risk ratios over two reporting dates",
  "config": {
    "font": "Inter, Arial, sans-serif",
    "background": "#ffffff",
    "view": {"stroke": "transparent"},
    "axis": {
      "labelColor": "#374151",
      "titleColor": "#374151",
      "gridColor": "#e5e7eb",
      "domainColor": "#d1d5db"
    },
    "legend": {"labelColor": "#374151", "titleColor": "#374151"}
  },
  "vconcat": [
    {
      "title": {
        "text": "Total Portfolio Balance (KZT Billion)",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#111827",
        "anchor": "start"
      },
      "data": {
        "values": [
          {"date": "Sep 1, 2026", "value": 498.15, "label": "498.15 B"},
          {"date": "Oct 1, 2026", "value": 484.67, "label": "484.67 B"}
        ]
      },
      "mark": {"type": "bar", "cornerRadiusTopLeft": 4, "cornerRadiusTopRight": 4},
      "encoding": {
        "x": {
          "field": "date",
          "type": "ordinal",
          "axis": {"labelAngle": 0, "title": null},
          "sort": null
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": {"title": "KZT Billion"},
          "scale": {"domain": [470, 510]}
        },
        "color": {
          "field": "date",
          "type": "nominal",
          "scale": {"range": ["#1d4ed8", "#1e40af"]},
          "legend": null
        },
        "tooltip": [
          {"field": "date", "type": "nominal", "title": "Date"},
          {"field": "value", "type": "quantitative", "title": "Portfolio (B KZT)", "format": ".2f"}
        ]
      },
      "width": 300,
      "height": 150
    },
    {
      "title": {
        "text": "Risk Ratios: PAR30 / PAR90 / NPL (%)",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#111827",
        "anchor": "start"
      },
      "data": {
        "values": [
          {"date": "Sep 1, 2026", "metric": "PAR30", "value": 12.05},
          {"date": "Sep 1, 2026", "metric": "PAR90", "value": 6.24},
          {"date": "Sep 1, 2026", "metric": "NPL",   "value": 11.85},
          {"date": "Oct 1, 2026", "metric": "PAR30", "value": 10.33},
          {"date": "Oct 1, 2026", "metric": "PAR90", "value": 4.46},
          {"date": "Oct 1, 2026", "metric": "NPL",   "value": 10.01}
        ]
      },
      "mark": {"type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3},
      "encoding": {
        "x": {
          "field": "date",
          "type": "ordinal",
          "axis": {"labelAngle": 0, "title": null},
          "sort": null
        },
        "xOffset": {"field": "metric", "type": "nominal", "sort": ["PAR30", "PAR90", "NPL"]},
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": {"title": "Percent (%)"}
        },
        "color": {
          "field": "metric",
          "type": "nominal",
          "scale": {
            "domain": ["PAR30", "PAR90", "NPL"],
            "range": ["#f59e0b", "#ef4444", "#7c3aed"]
          },
          "legend": {"title": "Metric"}
        },
        "tooltip": [
          {"field": "date",   "type": "nominal",      "title": "Date"},
          {"field": "metric", "type": "nominal",      "title": "Metric"},
          {"field": "value",  "type": "quantitative", "title": "Value (%)", "format": ".2f"}
        ]
      },
      "width": 300,
      "height": 150
    }
  ]
}
